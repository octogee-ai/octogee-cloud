    "@octogee/core": "file:../core",
    "@octogee/shared": "file:../shared",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "obsidian-headless": "0.0.14",
    "prom-client": "^15.1.3",
    "resend": "^6.37.0",
