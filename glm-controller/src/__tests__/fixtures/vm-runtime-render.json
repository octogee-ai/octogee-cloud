     ],
     "initContainers": [
      {
       "command": [
        "sh",
        "-c",
        "set -eu\n# -rn, not -a/-p: fsGroup owns /home/node, and preserving\n# source owner/timestamps needs FOWNER, which restricted PSA denies.\ncp -rn /etc/skel/. /home/node/\nmkdir -p /home/node/.npm-cache\ninstall -m 0500 /octogee/scripts/secret-resolver.mjs /octogee-secret-resolver/secret-resolver.mjs\n"
       ],
