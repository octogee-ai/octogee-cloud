[
 {
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
   "labels": {
    "app.kubernetes.io/instance": "octogee-gw-b-x",
    "app.kubernetes.io/managed-by": "Helm",
    "app.kubernetes.io/name": "octogee-gateway",
    "gateway-instance": "b-x",
    "helm.sh/chart": "octogee-gateway-0.1.0"
   },
   "name": "octogee-gateway-ingress-b-x",
   "namespace": "default"
  },
  "spec": {
   "ingress": [
    {
     "from": [
      {
       "podSelector": {
        "matchLabels": {
         "app": "gateway-router"
        }
       }
      }
     ],
     "ports": [
      {
       "port": 3001,
       "protocol": "TCP"
      }
     ]
    },
    {
     "from": [
      {
       "podSelector": {
        "matchLabels": {
         "app": "glm-controller"
        }
       }
      }
     ],
     "ports": [
      {
       "port": 3003,
       "protocol": "TCP"
      }
     ]
    },
    {
     "from": [
      {
       "podSelector": {
        "matchLabels": {
         "app": "mattermost-callback-router"
        }
       }
      },
      {
       "podSelector": {
        "matchLabels": {
         "app": "octogee-api"
        }
       }
      }
     ],
     "ports": [
      {
       "port": 3001,
       "protocol": "TCP"
      }
     ]
    },
    {
     "from": [
      {
       "podSelector": {
        "matchLabels": {
         "app": "octogee-gateway"
        }
       }
      }
     ],
     "ports": [
      {
       "port": 3003,
       "protocol": "TCP"
      },
      {
       "port": 30873,
       "protocol": "TCP"
      }
     ]
    },
    {
     "from": [
      {
       "namespaceSelector": {
        "matchLabels": {
         "kubernetes.io/metadata.name": "gke-gmp-system"
        }
       }
      }
     ],
     "ports": [
      {
       "port": 9092,
       "protocol": "TCP"
      }
     ]
    }
   ],
   "podSelector": {
    "matchLabels": {
     "app": "octogee-gateway",
     "gateway-instance": "b-x"
    }
   },
   "policyTypes": [
    "Ingress"
   ]
  }
 },
 {
