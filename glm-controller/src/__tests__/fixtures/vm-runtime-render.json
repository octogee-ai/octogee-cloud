        "allowPrivilegeEscalation": false,
        "capabilities": {
         "drop": [
          "ALL"
         ]
        },
        "readOnlyRootFilesystem": false
       },
       "startupProbe": {
        "failureThreshold": 60,
        "httpGet": {
         "path": "/startup-ready",
         "port": 3003
        },
        "initialDelaySeconds": 15,
        "periodSeconds": 10,
        "timeoutSeconds": 10
