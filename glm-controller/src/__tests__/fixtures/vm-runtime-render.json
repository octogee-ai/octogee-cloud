       "image": "us-docker.pkg.dev/octogee/octogee/gateway-edge:main.abc123",
       "livenessProbe": {
        "httpGet": {
         "path": "/health",
         "port": 3001
        },
        "initialDelaySeconds": 0,
        "periodSeconds": 30
       },
       "name": "gateway-edge",
       "ports": [
