{
  "name": "@octogee/scripts",
  "version": "1.0.0",
  "description": "Octogee local tooling scripts",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "provision": "tsx entrypoints/fleet-controller.ts",
    "prewith-platform-state": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "with-platform-state": "node ops/with-platform-state.mjs",
    "prerotate-secret-store-key": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "rotate-secret-store-key": "tsx ops/rotate-secret-store-key.ts",
    "pretest": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test": "npx vitest run __tests__",
    "audit-coverage": "tsx ops/audit-coverage.ts",
    "verify-silent-post": "tsx ops/verify-silent-post.ts",
    "verify:mattermost-capability": "tsx ops/verify-mattermost-capability-artifact.ts",
    "scope": "tsx ops/scope.ts",
    "audit-duplication": "node ops/audit-duplication.mjs",
    "gate": "tsx ci/factory-deny-list-scan.ts .."
  },
  "allowScripts": {
    "esbuild": true,
    "protobufjs": true,
    "@firebase/util": true,
    "fsevents": true,
    "re2": false
  },
  "nativeModules": [],
  "dependencies": {
    "@octogee/core": "file:../core",
    "@octogee/shared": "file:../shared",
    "@streamparser/json": "0.0.26",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "firebase-admin": "^14.3.0",
    "google-auth-library": "^11.0.2",
    "picocolors": "1.1.1",
    "tsx": "^4.23.15",
    "ws": "^8.21.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "pg": "8.23.1",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "2.1.6",
      "hono": "^4.13.11"
    },
    "@protobufjs/utf8": "^1.1.1",
    "@tootallnate/once": "^3.0.1",
    "body-parser@>=2.0.0 <3.0.0": "^2.4.0",
    "brace-expansion@<2.0.0": "1.1.21",
    "brace-expansion@>=2.0.0 <3.0.0": "2.1.7",
    "brace-expansion@>=5.0.0 <6.0.0": "5.0.12",
    "fast-xml-builder": "^1.1.7",
    "fast-uri": "^3.1.6",
    "glob": "14.0.3",
    "ip-address": "^10.2.1",
    "protobufjs": "^7.6.3",
    "qs": "^6.17.0",
    "re2": "1.26.1",
    "tar": "^7.5.16",
    "tmp": "^0.2.7",
    "uuid": "^14.0.0",
    "js-yaml": "^4.3.1",
    "@opentelemetry/core": "^2.8.0",
    "postcss": "8.5.25",
    "undici@<7.0.0": "^6.28.0",
    "basic-ftp": "^6.2.1"
  }
}
