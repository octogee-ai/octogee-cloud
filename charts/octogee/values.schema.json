{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "octogee values",
  "type": "object",
  "properties": {
    "previewGateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,44}[a-z0-9])?$",
          "description": "Name of the Gateway and HTTPRoute; the backend Service and its policies are named <name>-backend."
        },
        "domain": {
          "type": "string",
          "pattern": "^(|([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?\\.)+[a-z]([-a-z0-9]{0,61}[a-z0-9])?)$",
          "maxLength": 253,
          "description": "Base domain. The gateway serves *.<domain>."
        },
        "certificateMapName": {
          "type": "string",
          "description": "Certificate Manager certificate map, by name, holding a certificate for *.<domain>."
        },
        "staticIpName": {
          "type": "string",
          "description": "Reserved global external IP address, by name."
        },
        "securityPolicyName": {
          "type": "string",
          "description": "Cloud Armor backend security policy, by name, applied to every preview request."
        }
      },
      "if": {
        "properties": { "enabled": { "const": true } }
      },
      "then": {
        "required": ["domain", "certificateMapName", "staticIpName", "securityPolicyName"],
        "properties": {
          "domain": { "minLength": 1 },
          "certificateMapName": { "minLength": 1 },
          "staticIpName": { "minLength": 1 },
          "securityPolicyName": { "minLength": 1 }
        }
      }
    }
  }
}
