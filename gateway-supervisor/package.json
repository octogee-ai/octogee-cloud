{
  "name": "@octogee/gateway-supervisor",
  "version": "1.0.0",
  "description": "The gateway supervisor: the gateway pod boot steps and runners, and the VM agent, shipped in the gateway image",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "provision": "tsx entrypoints/provisioner.ts",
    "pretest": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "test": "npx vitest run __tests__",
    "pretypecheck": "node ../scripts/ops/sync-local-file-deps.mjs --consumer .",
    "typecheck": "tsc --noEmit"
  },
  "allowScripts": {
    "esbuild": true,
    "protobufjs": true,
    "@firebase/util": true,
    "fsevents": true,
    "re2": false
  },
  "nativeModules": [],
  "dependencies": {
    "@octogee/core": "file:../core",
    "@octogee/shared": "file:../shared",
    "@streamparser/json": "0.0.26",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "google-auth-library": "^11.0.2",
    "picocolors": "1.1.1",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.2.1",
    "pg": "8.23.1",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "2.1.6",
      "hono": "^4.13.11"
    },
    "@protobufjs/utf8": "^1.1.1",
    "@tootallnate/once": "^3.0.1",
    "body-parser@>=2.0.0 <3.0.0": "^2.4.0",
    "brace-expansion@<2.0.0": "1.1.21",
    "brace-expansion@>=2.0.0 <3.0.0": "2.1.7",
    "brace-expansion@>=5.0.0 <6.0.0": "5.0.12",
    "fast-xml-builder": "^1.1.7",
    "fast-uri": "^3.1.6",
    "glob": "14.0.3",
    "ip-address": "^10.2.1",
    "protobufjs": "^7.6.3",
    "qs": "^6.17.0",
    "re2": "1.26.1",
    "tar": "^7.5.16",
    "tmp": "^0.2.7",
    "uuid": "^14.0.0",
    "js-yaml": "^4.3.1",
    "@opentelemetry/core": "^2.8.0",
    "postcss": "8.5.25",
    "undici@<7.0.0": "^6.28.0",
    "basic-ftp": "^6.2.1"
  }
}
